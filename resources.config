// errorStrategy retry set: ((130..145) + 104 + 175 + 247 + 250)
//
// 130..145  Process killed by a fatal signal. POSIX/bash convention: exit = 128 + signal N.
//           134=SIGABRT(6), 137=SIGKILL(9)/OOM-kill, 139=SIGSEGV(11), 143=SIGTERM(15).
//           137 is the classic container/cgroup out of memory (OOM) kill (e.g. FreeBayes killed by the kernel).
//           https://www.gnu.org/software/bash/manual/html_node/Exit-Status.html
//           https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html
//           https://man7.org/linux/man-pages/man7/signal.7.html
// 104       Found in the nf-core retry code (no authoritative exit-code spec; NOT to be mistaken with
//           errno 104/ECONNRESET, errno numbers aren't even portable).
//           from nf-core pipeline-template conf/base.config, where the set is currently ((130..145) + 104 + (175..177)).
//           https://github.com/nf-core/tools/blob/main/nf_core/pipeline-template/conf/base.config
//           https://man7.org/linux/man-pages/man3/errno.3.html
// 175       Fusion Snapshots runtime "unrecoverable error" signal to Nextflow (Spot checkpoint/restore).
//           nf-core template later widened this to 175..177.
//           Found here: https://github.com/nf-core/rnaseq/pull/1553
// 247       256-9: SIGKILL through the gatk Python launcher (sys.exit(returncode); -9 & 0xFF = 247).
//           container/cgroup OOM-kill of the JVM behind the `gatk` wrapper.
//           No resource was found explicitly for this, but the below links are a good lead:
//           Observed during testing and in the .nextflow.log
//           https://github.com/broadinstitute/gatk/blob/master/gatk
//           https://docs.python.org/3/library/subprocess.html
// 250       256-6: SIGABRT through the gatk launcher (-6 & 0xFF = 250).
//           JVM heap OutOfMemoryError under -XX:+CrashOnOutOfMemoryError (JVM abort() -> core dump).
//           No resource was found explicitly for this, but the below links are a good lead:
//           Observed during testing and in the .nextflow.log
//           https://docs.oracle.com/en/java/javase/17/troubleshoot/troubleshooting-memory-leaks.html
//           https://github.com/broadinstitute/gatk/blob/master/gatk

// Resources configuration for uniflow pipeline

// This file defines the resources for different process labels in the uniflow pipeline.
// Before running the pipeline, make sure to set the MAX_CPU value to the actual max resource available on your compute system.
resources {
        MAX_CPU = 30
}


process {
        errorStrategy = {
                task.exitStatus in ((130..145) + 104 + 175 + 247 + 250)
                        ? 'retry'
                        : (workflow.profile.contains('latch') ? 'terminate' : 'finish')
        }
        maxRetries    = 1

        withLabel: small_job {
                cpus = 2
                memory = 10.GB
                queue = 'short'
        }
        withLabel: cpu_low_mem {
                cpus = resources.MAX_CPU/3
                memory = { task.attempt * 20.GB}
                maxRetries = 4
        }
        withLabel: demultiplexing_fastq {
                cpus = 12
                memory = { task.attempt * 60.GB}
                maxRetries = 4
        }

        withLabel: lazy_polars {
                cpus = resources.MAX_CPU
                memory = { task.attempt * 120.GB}
                maxRetries = 9
        }
        // Per-amplicon scatter callers resources
        withLabel: variant_calling_scatter {
                cpus = resources.MAX_CPU/5
                memory = { task.attempt * 120.GB}
                maxRetries = 3
        }
        withLabel: freebayes {
                cpus = 2
                memory = { task.attempt * 180.GB}
                maxRetries = 5
        }
        
        // Placeholder for a whole-BAM or a single ultra-high coverage amplicon
        withLabel: variant_calling_high_mem {
                cpus = resources.MAX_CPU/3
                memory = { task.attempt * 120.GB}
                maxRetries = 9
        }
}
