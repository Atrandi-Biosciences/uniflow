// GATK HaplotypeCaller OOM
//
// Forces GATK4_HAPLOTYPECALLER to start with a tiny heap so the
// OOM -> retry -> larger-heap order can be tested on a small sample.
//
//   nextflow run main.nf ... -profile docker \
//     -c test/test.config -c test/hc_oom_test.config --hc_test_start_mb 128 ...
//
// Here we uses a withName selector, which outranks test/test.config's
// withLabel: cpu_low_mem, so GATK's memory/errorStrategy below will run regardless
// -c order.

params {
    hc_test_start_mb = 32    // attempt 1 container memory (MB); heap ~= 80% of this
    hc_test_step_mb  = 128   // added per subsequent attempt
}

process {
    withName: 'GATK4_HAPLOTYPECALLER' {
        memory        = { (params.hc_test_start_mb + (task.attempt - 1) * params.hc_test_step_mb).MB }
        errorStrategy = { task.exitStatus in [1, 134, 137, 138, 139, 140, 247, 250] ? 'retry' : 'terminate' }
        maxRetries    = 6
    }
}
