nextflow_process {

    name "Test Process DNA_PROCESSING.QC_AMPLICON"
    script "modules/dna_processing.nf"
    process "QC_AMPLICON"

    //tag-definition
    tag "process"
    tag "process-dna_processing"
    tag "qc_amplicon"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"
            }
            process {
                """
                input[0] = Channel.of([
                [
                    sample_name: 'sample1'
                ],

                // positions
                file("${projectDir}/test_data/modules/dna_processing/qc_amplicon/positions.parquet"),

                // amplicon_upset_data
                file("${projectDir}/test_data/modules/dna_processing/qc_amplicon/amplicon_upset_data.parquet"),

                // Amplicon counts
                file("${projectDir}/test_data/modules/dna_processing/qc_amplicon/amplicon_counts.parquet"),

                // Top cells
                file("${projectDir}/test_data/modules/dna_processing/qc_amplicon/top_cells.parquet"),
                ])
                """
            }
        }

        then {
            assert process.success
        }

    }

}
