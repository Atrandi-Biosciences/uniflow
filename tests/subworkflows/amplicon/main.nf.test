nextflow_workflow {

    name "Test Workflow AMPLICON"
    script "subworkflows/amplicon/main.nf"
    workflow "AMPLICON"

    //tag-definition
    tag "subworkflow"
    tag "amplicon"

    test("Should run without failures") {

        when {
            params {
                experiment_id = "test_amplicon"
                load("${projectDir}/tests/params.json")
            }
            workflow {
                """
                // amplicon_entry 
                input[0] = Channel.of([
                    [ sample_name: 'sample1', library_type: 'DNA' ],
                    
                    // read_file_1
                    file("${projectDir}/test_data/subworkflows/amplicon/sample1_DNA_R1.fastq.gz"),
                
                    // read_file_2
                    file("${projectDir}/test_data/subworkflows/amplicon/sample1_DNA_R2.fastq.gz"),
                ])

                // amplicon_fasta_file_ch
                input[1] = Channel.value(
                    file("${params.imput_testdata}/qa/variant_calling_beta/amplicon_ref/intergenic_amplicon_50.fasta") 
                )

                // sample_barcode_mappings
                input[2] = Channel.of(
                    file("${projectDir}/test_data/subworkflows/variant/sample1_barcode_mappings.parquet")
                )
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
