nextflow_process {

    name "Test Process SHARED.MERGE_METRICS"
    script "modules/shared.nf"
    process "MERGE_METRICS"

    //tag-definition
    tag "process"
    tag "shared"
    tag "merge_metrics"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"                
            }
            process {
                """
                input[0] = Channel.of([
                    "Lib2_DNA_L001",
                    
                    
                    file("${projectDir}/test_data/modules/shared/merge_metrics/DNA/1/metrics.parquet")
                ])
                """
            }
        }

        then {
            assert process.success
        }

    }

}
