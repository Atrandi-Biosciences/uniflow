class TestUtils{
    static void print_output_channels(def wf) {
        println "\n=== OUTPUT CHANNELS ==="

        println "rna_libraries (${wf.out.rna_libraries.size()} items):"
        println wf.out.rna_libraries

        println "\ndna_libraries (${wf.out.dna_libraries.size()} items):"
        println wf.out.dna_libraries

        println "\nper_sample_reads (${wf.out.per_sample_reads.size()} items):"
        println wf.out.per_sample_reads

        println "\nper_sample_barcode_mappings: (${wf.out.dna_libraries.size()} items):"
        println wf.out.per_sample_barcode_mappings
    }
}

nextflow_workflow {

    name "Test Workflow DEMULTIPLEXING"
    script "workflows/demultiplexing.nf"
    workflow "DEMULTIPLEXING"


    //tag-definition
    tag "workflow"
    tag "demultiplexing"
    //Test ID -> RNAampDNA_Traceability_Matrix
    tag "TEST-DEMULTIPLEXING"

    // --- GLOBALE VARIABLES ---
    def debug = false
    def pathToInputCsv = "test_data/endToEnd"
    // ---------- RNA ----------
    // ----- LIBRARY_TYPE ------
    def Lib1_RNA_L001 = "Lib1_RNA_L001"
    def Lib1_RNA_L002 = "Lib1_RNA_L002"
    def Lib3_RNA_L001 = "Lib3_RNA_L001"
    def Lib3_RNA_L002 = "Lib3_RNA_L002"

    // ---------- DNA ----------
    // ----- LIBRARY_TYPE ------
    def Lib2_DNA_L001 = "Lib2_DNA_L001"
    def Lib2_DNA_L002 = "Lib2_DNA_L002"
    def Lib4_DNA_L001 = "Lib4_DNA_L001"
    def Lib4_DNA_L002 = "Lib4_DNA_L002"

    // ---------------------------- PASS TESTCASES --------------------------

    test("TEST-DEMULTIPLEXING_001: (PASS) S1_LT2: the output should be 2 files for DNA and 2 files for RNA") {

        when {
            params {
                experiment_id = "test_demultiplex_pass"
                load("${projectDir}/tests/params.json")
            }
            workflow {
                """
                // samples_ch
                input[0] = Channel.fromList([
                    [
                        [sample_name: 'sample1', library_id: '${Lib1_RNA_L001}', library_type: 'RNA'],
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib1_RNA_L001}_R1_001.fastq.gz"),
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib1_RNA_L001}_R2_001.fastq.gz")
                    ],
                    [
                        [sample_name: 'sample1', library_id: '${Lib2_DNA_L001}', library_type: 'DNA'],
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib2_DNA_L001}_R1_001.fastq.gz"),
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib2_DNA_L001}_R2_001.fastq.gz")
                    ]
                ])

                // corrected_barcodes_ch
                input[1] = Channel.fromList([  
                    [
                        '${Lib1_RNA_L001}', 'RNA',
                        file("${params.imput_testdata}/qa/parquet_test/${Lib1_RNA_L001}_barcodes.parquet")
                    ],
                    [
                        '${Lib2_DNA_L001}', 'DNA',
                        file("${params.imput_testdata}/qa/parquet_test/${Lib2_DNA_L001}_barcodes.parquet")
                    ]

                ])

                // input_csv
                input[2] = file("${projectDir}/${pathToInputCsv}/pass/S1_LT2.csv")

                // inputs_validated
                input[3] = Channel.of(true)                     

                // bc_long
                input[4] = file("${projectDir}/assets/barcodes/B4_24_v01/long.csv")

                // chemistry_json_path
                input[5] = "${projectDir}/test_data/subworkflows/barcode/chemistry.json"
                """
            }
        }

        then {
            if (debug) {
                TestUtils.print_output_channels(workflow)
            }

            assert workflow.success
            def rna = workflow.out.rna_libraries
            def dna = workflow.out.dna_libraries
            def barcode = workflow.out.per_sample_barcode_mappings
            assert rna.size() == 1          // count libraries
            assert rna.get(0).size() == 3   // 1 meta + 2 files
             
            assert dna.size() == 1          // count libraries
            assert dna.get(0).size() == 3   // 1 meta + 2 files
            
            assert barcode.size() == 2
            assert barcode.get(0).size() == 2   // 2 files
            assert barcode.get(1).size() == 2   // 2 files
        }
    }

