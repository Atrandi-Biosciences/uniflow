nextflow_process {

    name "Test Process SHARED.TRIM_READS"
    script "modules/shared.nf"
    process "TRIM_READS"

    //tag-definition
    tag "process"
    tag "shared"
    tag "trim_reads"

    test("Should trim reads with 100 lenght") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"                
            }
            process {
                """
                // meta, read1, read2
                input[0] = Channel.of([
                    [ sample_name: 'sample1', library_type: 'RNA' ],
                    
                    // read_file_1
                    //ANTGACCTTAAGTTCATTGACACCACCTCCAAGTTTGGCCATGGCCGCTTCCAGACCATGGAGGAGAAGAAAGCATTCATGGGACCACTGAAGAAAGACCGAATTGCAAAGGAAGAAGAAGCTTAATGCCAGGAACAGATTTTGCAGT
                    file("${projectDir}/test_data/modules/shared/trim_reads/sample1_RNA_R1.fastq.gz"),
                
                    // read_file_2
                    //GTGAGACTAGGACACCTTGAACTCCACCATCTAAGGCATACCGTGACTTGAGTGGCTGTCGGCTGAGCTT
                    file("${projectDir}/test_data/modules/shared/trim_reads/sample1_RNA_R2.fastq.gz"),
                ])
                
                //trimming_lenght
                input[1] = Channel.of( 100 )
                """
            }
        }

        then {
            assert workflow.success
            //assert snapshot(process.out.trimmed_fastq).match()           
        }

    }

    test("Should trim reads with 50 lenght") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"                
            }
            process {
                """
                // meta, read1, read2
                input[0] = Channel.of([
                    [ sample_name: 'sample1', library_type: 'RNA' ],
                    
                    // read_file_1
                    //ANTGACCTTAAGTTCATTGACACCACCTCCAAGTTTGGCCATGGCCGCTTCCAGACCATGGAGGAGAAGAAAGCATTCATGGGACCACTGAAGAAAGACCGAATTGCAAAGGAAGAAGAAGCTTAATGCCAGGAACAGATTTTGCAGT
                    file("${projectDir}/test_data/modules/shared/trim_reads/sample1_RNA_R1.fastq.gz"),
                
                    // read_file_2
                    //GTGAGACTAGGACACCTTGAACTCCACCATCTAAGGCATACCGTGACTTGAGTGGCTGTCGGCTGAGCTT
                    file("${projectDir}/test_data/modules/shared/trim_reads/sample1_RNA_R2.fastq.gz"),
                ])
                
                //trimming_lenght
                input[1] = Channel.of( 50 )
                """
            }
        }

        then {            
            assert workflow.success
            //assert snapshot(process.out.trimmed_fastq).match()           
        }

    }

}
