nextflow_workflow {

    name "Test Workflow VARIANT_CALLING"
    script "subworkflows/variant/calling.nf"
    workflow "VARIANT_CALLING"

    //tag-definition
    tag "subworkflow"
    tag "variant_calling"

    test("Should run without failures") {

        when {
            params {
                experiment_id = "test_variant_calling"
                load("${projectDir}/tests/params.json")
            }
            workflow {
                """
                // bam_with_index
                input[0] = Channel.of([
                    [ sample_name: 'sample1', library_type: 'DNA' ],
                    file("${params.imput_testdata}/qa/variant_calling_beta/regression-tests-input/aligned.sorted.bam"),
                    file("${params.imput_testdata}/qa/variant_calling_beta/regression-tests-input/aligned.sorted.bam.bai")
                ])


                // amplicon_fasta
                input[1] = Channel.value(
                    file("${params.imput_testdata}/qa/variant_calling_beta/amplicon_ref/intergenic_amplicon_50.fasta")
                )
                """
            }
        }

        then {
            assert workflow.success
        }

    }

}
