nextflow_workflow {

    name "Test Workflow VARIANT_HARMONIZE"
    script "subworkflows/variant/harmonize.nf"
    workflow "VARIANT_HARMONIZE"

    //tag-definition
    tag "subworkflow"
    tag "variant_harmonize"


    test("Harmonize should run without failures") {
        when {
            params {
                experiment_id = "test_variant_harmonize"
                load("${projectDir}/tests/params.json")
            }

            workflow {
                """
                input[0] = Channel.of([
                    [ sample_name: 'sample1'],
                    "bcftools",
                    file("${projectDir}/test_data/subworkflows/variant/harmonize/sample1.bcftools.filtered.vcf.gz")
                ],
                [
                    [ sample_name: 'sample1'],
                    "freebayes",
                    file("${projectDir}/test_data/subworkflows/variant/harmonize/sample1.freebayes.filtered.vcf.gz")
                ],

                [
                    [ sample_name: 'sample1'],
                    "gatkhc",
                    file("${projectDir}/test_data/subworkflows/variant/harmonize/sample1.gatkhc.filtered.vcf.gz")
                ],

                [
                    [ sample_name: 'sample1'],
                    "vardict",
                    file("${projectDir}/test_data/subworkflows/variant/harmonize/sample1.vardict.filtered.vcf.gz")
                ]
                )
                """
            }
        }

        then {
            assert workflow.success
            def vcfPath = path(workflow.out.harmonized.get(0).get(2))

            assert snapshot(
                vcfPath.vcf.chromosomes,
                vcfPath.vcf.variantCount,
                vcfPath.vcf.sampleCount 
            ).match("vcf_summary")
        }

    }
}
