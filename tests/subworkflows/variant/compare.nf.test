nextflow_workflow {

    name "Test Workflow VARIANT_COMPARE"
    script "subworkflows/variant/compare.nf"
    workflow "VARIANT_COMPARE"

    //tag-definition
    tag "subworkflow"
    tag "variant_compare"

    test("Should run without failures") {

        when {
            params {
                experiment_id = "test_variant_compare"
                load("${projectDir}/tests/params.json")
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ sample_name: 'sample1'],
                    "bcftools",
                    file("${projectDir}/test_data/subworkflows/variant/merging/sample1.bcftools.filled.vcf.gz")
                ],
                
                [
                    [ sample_name: 'sample1'],
                    "freebayes",
                    file("${projectDir}/test_data/subworkflows/variant/merging/sample1.freebayes.filled.vcf.gz")
                ],

                [
                    [ sample_name: 'sample1'],
                    "gatkhc",
                    file("${projectDir}/test_data/subworkflows/variant/merging/sample1.gatkhc.filled.vcf.gz")
                ],

                [
                    [ sample_name: 'sample1'],
                    "vardict",
                    file("${projectDir}/test_data/subworkflows/variant/merging/sample1.vardict.filled.vcf.gz")
                ])
                
                //
                input[1] = file("${params.imput_testdata}/qa/variant_calling_beta/amplicon_ref/intergenic_amplicon_50.fasta")

                //
                input[2] = file("${projectDir}/test_data/subworkflows/variant/intergenic_amplicon_50.fasta.fai")
                """
            }
        }

        then {
            assert workflow.success
        }

    }

}
