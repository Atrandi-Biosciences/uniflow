nextflow_process {

    name "Test Process DNA_PROCESSING.COUNT_AMPLICON"
    script "modules/dna_processing.nf"
    process "COUNT_AMPLICON"

    //tag-definition
    tag "process"
    tag "process-dna_processing"
    tag "count_amplicon"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"
            }
            process {
                """
                input[0] = Channel.of([
                [
                    sample_name: 'sample1'
                ],

                // full_read_parquet
                file("${projectDir}/test_data/modules/dna_processing/count_amplicon/DNA/full_read_DNA.parquet"),

                // reference_fasta
                file("${projectDir}/test_data/modules/dna_processing/count_amplicon/DNA/test_ref.fasta")
                ])
                """
            }
        }

        then {
            assert process.success
        }

    }

}
