nextflow_process {

    name "Test Process SHARED.CONCATENATE_FASTQ"
    script "modules/shared.nf"
    process "CONCATENATE_FASTQ"
    
    //tag-definition
    tag "process"
    tag "shared"
    tag "concatenate_fastq"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"                
            }
            process {
                """
                input[0] = Channel.of([
                    [ sample_name: 'sample1', library_type: 'DNA' ],
                    
                    // read1_files
                    [
                    file("${projectDir}/test_data/modules/shared/concatenate_fastq/1/Lib2_DNA_L001_R1_001.fastq.gz"),
                    file("${projectDir}/test_data/modules/shared/concatenate_fastq/2/Lib2_DNA_L002_R1_001.fastq.gz")
                    ],
                
                    // read2_files
                    [
                    file("${projectDir}/test_data/modules/shared/concatenate_fastq/1/Lib2_DNA_L001_R2_001.fastq.gz"),
                    file("${projectDir}/test_data/modules/shared/concatenate_fastq/2/Lib2_DNA_L002_R2_001.fastq.gz")
                    ]

                ])
                """
            }
        }

        then {
            assert process.success
            //assert snapshot(process.out).match()
        }

    }

}
