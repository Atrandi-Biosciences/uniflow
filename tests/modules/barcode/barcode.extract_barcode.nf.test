nextflow_process {

    name "Test Process BARCODE.EXTRACT_BARCODE"
    script "modules/barcode.nf"
    process "EXTRACT_BARCODE"

    //tag-definition
    tag "process"
    tag "extract_barcode"

    test("Extract RNA barcode should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"
                r2_lengths = ["rna":70, "dna":48]
            }
            process {
                """
                input[0] = Channel.of([
                    
                    // library_id
                    "Lib1_RNA_L002",

                    // library_type
                    "RNA",

                    // read2
                    file("${projectDir}/test_data/modules/barcode/extract_barcode/RNA/Lib1_RNA_L002_R2_001.fastq.gz"),
                ])

                // validation_done
                input[1] = true
                input[2] = ${params.r2_lengths}
                """
            }
        }

        then {     
            assert process.success

            // 1. Snapshot of a single output channel
            //assert snapshot(process.out.my_channel).match()

            // 2. Snapshot of all outputs from a process
            assert snapshot(process.out).match()

            // 3. Full process snapshot (includes all channels, success status, logs, etc.)
            //assert snapshot(process).match()

            // 4. Full process snapshot
            //assert snapshot(process).match()

            // 5. Snapshot of individual file(s)
            //assert snapshot(path(process.out.get(0))).match()
            //assert snapshot(path(process.out.barcode_extracted.get(0)[3])).match()

            def parquetPath = file(process.out.barcode_extracted.get(0)[3]).toString()
            
            def pythonScript = """
                import polars as pl
                pf = pl.read_parquet('${parquetPath}')
                assert pf["read_name"].item(0) == 'LH00337:52:22HMMJLT1:2:1101:2960:1192', f'expect: LH00337:52:22HMMJLT1:2:1101:2960:1192, but have { pf["read_name"].item(0) }'
                assert pf["D"].item(0) == 'CGCTAGTT', f'expect: CGCTAGTT, but have { pf["D"].item(0) }'
                assert pf["C"].item(0) == 'ATGGTGTG', f'expect: ATGGTGTG, but have { pf["C"].item(0) }'
                assert pf["B"].item(0) == 'TGTTGGAC', f'expect: TGTTGGAC, but have { pf["B"].item(0) }'
                assert pf["A"].item(0) == 'CATACCGT', f'expect: CATACCGT, but have { pf["A"].item(0) }'
                assert pf["primer"].item(0) == 'GACTTGAGTGGCTGTCGG', f'expect: GACTTGAGTGGCTGTCGG, but have { pf["primer"].item(0) }'
                assert pf["umi"].item(0) == 'AACTCTCC', f'expect: AACTCTCC, but have { pf["umi"].item(0) }'
                print('PARQUET_OK')
            """.stripIndent().trim()

            // executes the Python code in the terminal (-c executes code directly from the string)
            def prozess = ["python3", "-c", pythonScript].execute()
    
            // Use a StringBuffer to safely buffer outputs in parallel with the process
            StringBuffer outBuffer = new StringBuffer()
            StringBuffer errBuffer = new StringBuffer()
            
            // captures stdout and stderr separately and waits until Python finishes
            prozess.waitForProcessOutput(outBuffer, errBuffer)

            String pythonResult = outBuffer.toString().trim()
            String pythonError  = errBuffer.toString().trim()
            

            // if Python fails (exitValue != 0), print the error to the terminal
            if (prozess.exitValue() != 0) {
                println "\n================ PYTHON ASSERTION FAILED ================"
                println pythonError
                println "=========================================================\n"
            }

            assertAll(
                { assert file(parquetPath).exists() },
                { assert file(parquetPath).name.endsWith(".parquet") },
                { assert prozess.exitValue() == 0 },
                { assert pythonResult  == "PARQUET_OK" }
            ) 
        }

    }

    test("Extract DNA barcode should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"
                r2_lengths = ["rna":70, "dna":48]
            }
            process {
                """
                input[0] = Channel.of([
                    
                    // library_id
                    "Lib2_DNA_L002",

                    // library_type
                    "DNA",

                    // read2
                    file("${projectDir}/test_data/modules/barcode/extract_barcode/DNA/Lib2_DNA_L001_R2_001.fastq.gz"),
                ])

                // validation_done
                input[1] = true
                input[2] = ${params.r2_lengths}
                """
            }
        }

        then {
            assert process.success
           
            // Snapshot of all outputs from a process
            assert snapshot(process.out).match()

            def parquetPath = file(process.out.barcode_extracted.get(0)[3]).toString()
            
            def pythonScript = """
                import polars as pl
                pf = pl.read_parquet('${parquetPath}')
                assert pf["read_name"].item(0) == 'LH00337:52:22HMMJLT1:1:1101:21626:1208', f'expect: LH00337:52:22HMMJLT1:1:1101:21626:1208, but have { pf["read_name"].item(0) }'
                assert pf["D"].item(0) == 'GGTCATTG', f'expect: GGTCATTG, but have { pf["D"].item(0) }'
                assert pf["C"].item(0) == 'AGACCGAT', f'expect: AGACCGAT, but have { pf["C"].item(0) }'
                assert pf["B"].item(0) == 'AGACACCA', f'expect: AGACACCA, but have { pf["B"].item(0) }'
                assert pf["A"].item(0) == 'TTCCACTC', f'expect: TTCCACTC, but have { pf["A"].item(0) }'
                print('PARQUET_OK')
            """.stripIndent().trim()

            // executes the Python code in the terminal (-c executes code directly from the string)
            def prozess = ["python3", "-c", pythonScript].execute()
    
            // Use a StringBuffer to safely buffer outputs in parallel with the process
            StringBuffer outBuffer = new StringBuffer()
            StringBuffer errBuffer = new StringBuffer()
            
            // captures stdout and stderr separately and waits until Python finishes
            prozess.waitForProcessOutput(outBuffer, errBuffer)

            String pythonResult = outBuffer.toString().trim()
            String pythonError  = errBuffer.toString().trim()
            

            // if Python fails (exitValue != 0), print the error to the terminal
            if (prozess.exitValue() != 0) {
                println "\n================ PYTHON ASSERTION FAILED ================"
                println pythonError
                println "=========================================================\n"
            }

            assertAll(
                { assert file(parquetPath).exists() },
                { assert file(parquetPath).name.endsWith(".parquet") },
                { assert prozess.exitValue() == 0 },
                { assert pythonResult  == "PARQUET_OK" }
            )            
        }
    }
}
