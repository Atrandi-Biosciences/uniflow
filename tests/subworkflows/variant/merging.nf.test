nextflow_workflow {

    name "Test Workflow VARIANT_MERGING"
    script "subworkflows/variant/merging.nf"
    workflow "VARIANT_MERGING"

    //tag-definition
    tag "subworkflow"
    tag "variant_merging"

    test("Merging should run without failures") {
        when {
            params {
                experiment_id = "test_variant_merging"
                load("${projectDir}/tests/params.json")
            }

            workflow {
                """
                input[0] = Channel.of([
                    [ sample_name: 'sample1'],
                    "bcftools",
                    file("${projectDir}/test_data/subworkflows/variant/merging/sample1.bcftools.filled.vcf.gz")
                ],
                
                [
                    [ sample_name: 'sample1'],
                    "freebayes",
                    file("${projectDir}/test_data/subworkflows/variant/merging/sample1.freebayes.filled.vcf.gz")
                ],

                [
                    [ sample_name: 'sample1'],
                    "gatkhc",
                    file("${projectDir}/test_data/subworkflows/variant/merging/sample1.gatkhc.filled.vcf.gz")
                ],

                [
                    [ sample_name: 'sample1'],
                    "vardict",
                    file("${projectDir}/test_data/subworkflows/variant/merging/sample1.vardict.filled.vcf.gz")
                ])
                """
            }
        }

        then {
            assert workflow.success
       
            def vcfPath = path(workflow.out.merged_vcf.get(0).get(1))
            assert snapshot(
                vcfPath.vcf.chromosomes,
                vcfPath.vcf.variantCount,
                vcfPath.vcf.sampleCount 
            ).match("vcf_summary")
        }

    }
}
