nextflow_process {

    name "Test Process BARCODE.CORRECT_BARCODE"
    script "modules/barcode.nf"
    process "CORRECT_BARCODE"

    //tag-definition
    tag "process"
    tag "correct_barcode"

    test("Checking for correct barcodes for the library type RNA should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"
            }
            process {
                """
                input[0] = Channel.of([
                    
                    // read2
                    file("${projectDir}/test_data/modules/barcode/correct_barcode/RNA/Lib1_RNA_L001_R2_001.fastq.gz"),

                    // library_id
                    "Lib1_RNA_L001",

                    // library_type
                    "RNA",

                    // barcode_parquet_path
                    file("${projectDir}/test_data/modules/barcode/correct_barcode/RNA/Lib1_RNA_L001_barcodes.parquet"),

                    // barcode_whitelist_path
                    file("${projectDir}/test_data/modules/barcode/correct_barcode/RNA/long.csv"),
                ])
                """
            }
        }

        then {
            assert process.success

            // Snapshot of all outputs from a process
            assert snapshot(process.out).match()

            def corrected_barcodes_parquet_file = file(process.out.corrected_barcodes.get(0)[2]).toString()
            def barcodes_mapping_parquet_file = file(process.out.barcode_mapping.get(0)[2]).toString()
            
            def python_script_corrected_barcodes = """
                import polars as pl
                pf = pl.read_parquet('${corrected_barcodes_parquet_file}')
                assert pf["read_name"].item(0) == 'LH00337:52:22HMMJLT1:1:1101:7398:1160', f'expect: LH00337:52:22HMMJLT1:1:1101:7398:1160, but have { pf["read_name"].item(0) }'
                assert pf["D"].item(0) == 'GTGAGACT', f'expect: GTGAGACT, but have { pf["D"].item(0) }'
                assert pf["C"].item(0) == 'CACCTTGA', f'expect: CACCTTGA, but have { pf["C"].item(0) }'
                assert pf["B"].item(0) == 'CACCATCT', f'expect: CACCATCT, but have { pf["B"].item(0) }'
                assert pf["A"].item(0) == 'CATACCGT', f'expect: CATACCGT, but have { pf["A"].item(0) }'
                assert pf["primer"].item(0) == 'GACTTGAGTGGCTGTCGG', f'expect: GACTTGAGTGGCTGTCGG, but have { pf["primer"].item(0) }'
                assert pf["umi"].item(0) == 'CTGAGCTT', f'expect: CTGAGCTT, but have { pf["umi"].item(0) }'

                pf = pl.read_parquet('${barcodes_mapping_parquet_file}')
                assert pf["read_name"].item(0) == 'LH00337:52:22HMMJLT1:1:1101:7398:1160', f'expect: LH00337:52:22HMMJLT1:1:1101:7398:1160, but have { pf["read_name"].item(0) }'
                assert pf["barcode"].item(0) == 'GTGAGACT_CACCTTGA_CACCATCT_CATACCGT', f'expect: GTGAGACT_CACCTTGA_CACCATCT_CATACCGT, but have { pf["D"].item(0) }'
                assert pf["primer"].item(0) == 'GACTTGAGTGGCTGTCGG', f'expect: GACTTGAGTGGCTGTCGG, but have { pf["primer"].item(0) }'
                assert pf["umi"].item(0) == 'CTGAGCTT', f'expect: CTGAGCTT, but have { pf["umi"].item(0) }'
                
                print('PARQUET_OK')
            """.stripIndent().trim()

            // executes the Python code in the terminal (-c executes code directly from the string)
            def prozess = ["python3", "-c", python_script_corrected_barcodes].execute()
    
            // Use a StringBuffer to safely buffer outputs in parallel with the process
            StringBuffer out_buffer = new StringBuffer()
            StringBuffer err_buffer = new StringBuffer()
            
            // captures stdout and stderr separately and waits until Python finishes
            prozess.waitForProcessOutput(out_buffer, err_buffer)

            String python_result = out_buffer.toString().trim()
            String python_error  = err_buffer.toString().trim()
            

            // if Python fails (exitValue != 0), print the error to the terminal
            if (prozess.exitValue() != 0) {
                println "\n================ PYTHON ASSERTION FAILED ================"
                println python_error
                println "=========================================================\n"
            }

            assertAll(
                { assert prozess.exitValue() == 0 },
                { assert python_result  == "PARQUET_OK" }
            )
        }

    }

    test("Checking for correct barcodes for the library type DNA should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"
            }
            process {
                """
                input[0] = Channel.of([
                    
                    // read2
                    file("${projectDir}/test_data/modules/barcode/correct_barcode/DNA/Lib2_DNA_L001_R2_001.fastq.gz"),

                    // library_id
                    "Lib2_DNA_L001",

                    // library_type
                    "DNA",

                    // barcode_parquet_path
                    file("${projectDir}/test_data/modules/barcode/correct_barcode/DNA/Lib2_DNA_L001_barcodes.parquet"),

                    // barcode_whitelist_path
                    file("${projectDir}/test_data/modules/barcode/correct_barcode/DNA/long.csv"),
                ])
                """
            }
        }

        then {
            assert process.success
            
            // Snapshot of all outputs from a process
            assert snapshot(process.out).match()

            def corrected_barcodes_parquet_file = file(process.out.corrected_barcodes.get(0)[2]).toString()
            def barcodes_mapping_parquet_file = file(process.out.barcode_mapping.get(0)[2]).toString()
            
            def python_script_corrected_barcodes = """
                import polars as pl
                pf = pl.read_parquet('${corrected_barcodes_parquet_file}')
                assert pf["read_name"].item(0) == 'LH00337:52:22HMMJLT1:1:1101:21626:1208', f'expect: LH00337:52:22HMMJLT1:1:1101:7398:1160, but have { pf["read_name"].item(0) }'
                assert pf["D"].item(0) == 'GGTCATTG', f'expect: GGTCATTG, but have { pf["D"].item(0) }'
                assert pf["C"].item(0) == 'AGACCGAT', f'expect: AGACCGAT, but have { pf["C"].item(0) }'
                assert pf["B"].item(0) == 'AGACACCA', f'expect: AGACACCA, but have { pf["B"].item(0) }'
                assert pf["A"].item(0) == 'TTCCACTC', f'expect: TTCCACTC, but have { pf["A"].item(0) }'

                pf = pl.read_parquet('${barcodes_mapping_parquet_file}')
                assert pf["read_name"].item(0) == 'LH00337:52:22HMMJLT1:1:1101:21626:1208', f'expect: LH00337:52:22HMMJLT1:1:1101:21626:1208, but have { pf["read_name"].item(0) }'
                assert pf["barcode"].item(0) == 'GGTCATTG_AGACCGAT_AGACACCA_TTCCACTC', f'expect: GGTCATTG_AGACCGAT_AGACACCA_TTCCACTC, but have { pf["D"].item(0) }'
                
                print('PARQUET_OK')
            """.stripIndent().trim()

            // executes the Python code in the terminal (-c executes code directly from the string)
            def prozess = ["python3", "-c", python_script_corrected_barcodes].execute()
    
            // Use a StringBuffer to safely buffer outputs in parallel with the process
            StringBuffer out_buffer = new StringBuffer()
            StringBuffer err_buffer = new StringBuffer()
            
            // captures stdout and stderr separately and waits until Python finishes
            prozess.waitForProcessOutput(out_buffer, err_buffer)

            String python_result = out_buffer.toString().trim()
            String python_error  = err_buffer.toString().trim()
            

            // if Python fails (exitValue != 0), print the error to the terminal
            if (prozess.exitValue() != 0) {
                println "\n================ PYTHON ASSERTION FAILED ================"
                println python_error
                println "=========================================================\n"
            }

            assertAll(
                { assert prozess.exitValue() == 0 },
                { assert python_result  == "PARQUET_OK" }
            )
        }

    }

}
