// Global default params, used in configs
workflow.output.mode = 'copy'

plugins {
  id 'nf-schema@2.5.1'
}

params {
    version = "0.1.0"
    // generic options
    help = false
    protocol = 'CB_UMI_Complex'
    solofeature = "GeneFull"
    outdir = 'results'
    trimming_length = 100
    experiment_id = null
    disable_validation = false
    internal = true

    // variant calling options (mirror nextflow_schema.json defaults)
    run_variant_calling = true
    variant_callers = 'freebayes,bcftools,gatkhc,vardict'
    amplicon_bed = null
    // gq_calibration: whether THIS sample has its own ground-truth VCF
    gq_calibration = 'inherited'   // inherited | truth-calibrated

    // downsampling options:
    // per_cell_per_amplicon_downsample: CB-aware per-(cell, amplicon) cap on the
    //   shared variant BAM (bulk + per-cell).
    per_cell_per_amplicon_downsample = true   // true | false (disable with --per_cell_per_amplicon_downsample false)
    downsample_reads_per_cell_amplicon = 100  // per-(cell, amplicon) cap N + candidate-N marker on QC
    downsample_seed = 42                      // fixed seed for reproducible sampling
}

profiles{
    test {
        docker.enabled = true
        
        process {
            executor = "local"
            cpus=2
            memory={2.GB + task.attempt * 1.GB}
            errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
            maxRetries = 3
        }
    }
    docker {
        docker.enabled = true
        process.executor = 'local'
        includeConfig 'resources.config'
    }
    latch {
        docker.enabled = true
        process.executor = 'k8s'
        includeConfig 'resources.config'
    }
    apptainer {
        docker.enabled = false
        apptainer.enabled = true
        includeConfig 'resources.config'
    }
    
}

includeConfig 'conf/variant.config'

// using manifest (instead of params) for run versioning
manifest {
   version = '0.1.0'
}
// must be set before any usage below (e.g., timeline/trace/report/outputDir);
// otherwise params.version reads as an empty ConfigObject and renders as "[:]"
// Good old Groovy!

// outputDir is special "reserved" variable, that corresponds to -output-dir in CLI call: https://nextflow.io/docs/stable/workflow.html#publishing-files
// this has to be defined AFTER params
def output_dir = params.experiment_id ? "${params.outdir}/${params.experiment_id}_${params.version}" : "${params.outdir}"
outputDir = output_dir

def run_stamp = new java.util.Date().format('yyyyMMdd_HHmmss')

trace {
    enabled = true
    overwrite = true
    file = "${output_dir}/pipeline_info/trace_${run_stamp}.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,cpus,memory,submit,duration,realtime,%cpu,%mem,peak_rss,peak_vmem,rchar,wchar,workdir'
}

report {
    enabled = true
    overwrite = true
    file = "${output_dir}/pipeline_info/report_${run_stamp}.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "${output_dir}/pipeline_info/timeline_${run_stamp}.html"
}