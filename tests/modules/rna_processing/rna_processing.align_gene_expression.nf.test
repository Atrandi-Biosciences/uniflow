nextflow_process {

    name "Test Process RNA_PROCESSING.ALIGN_GENE_EXPRESSION"
    script "modules/rna_processing.nf"
    process "ALIGN_GENE_EXPRESSION"

    //tag-definition
    tag "process"
    tag "process-rna_processing"
    tag "align_gene_expression"

    test("Should run without failures") {

        skip() //testcase is very slow. we need a smaller STAR index.

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"
            }
            process {
                """
                
                input[0] = Channel.of([
                [
                    sample_name: 'sample1', 
                    library_type: 'RNA'
                ],
                file("${projectDir}/test_data/modules/rna_processing/align_gene_expression/sample1_R1.trimmed.fastq.gz"),
                file("${projectDir}/test_data/modules/rna_processing/align_gene_expression/sample1_R2.trimmed.fastq.gz")
                ])

                // STAR genome index
                input[1] = file("${projectDir}/test_data/modules/rna_processing/align_gene_expression/star_index_chr13")

                // Whitelists
                input[2] = [
                    file("${projectDir}/test_data/modules/rna_processing/align_gene_expression/bcD_24.txt"),
                    file("${projectDir}/test_data/modules/rna_processing/align_gene_expression/bcC_24.txt"),
                    file("${projectDir}/test_data/modules/rna_processing/align_gene_expression/bcB_24.txt"),
                    file("${projectDir}/test_data/modules/rna_processing/align_gene_expression/bcA_24_wRT.txt")
                ]

                // protocol
                input[3] = "CB_UMI_Complex"

                // features
                input[4] = "GeneFull"
                """
            }
        }

        then {
            assert process.success
        }

    }

}
