// Per-process ext.args for the variant-calling path, and for that path ONLY.
// All other modules handle their ext.args internally. A `withName` block for a
// non-variant process does not belong here: give it its own sibling config and
// add an includeConfig line, or this file's name stops being true the first
// time an unrelated process lands in it.

// Bulk (pseudobulk) discovery per each variant caller
// Not all callers have native CLI params for the following items
def bulk_max_dp        = 10000000 // per-position DP cap
def bulk_min_alt_reads = 20       // uniform AD[ALT] floor at BCFTOOLS_FILTER
def bulk_min_vaf       = 0.0001   // uniform VAF floor at BCFTOOLS_FILTER

// Keep both of these variant callers above the percell_error_eps threshold of 4.5e-4
def freebayes_min_vaf     = 0.001
def vardict_min_vaf       = 0.001
def variant_min_dp     = 0        // retired INFO/DP site filter (0 = off)

// Qualities on NovaSeq are the four bins {2, 9, 24, 40}, so 
// 13 admits {24, 40}
def bulk_min_bq        = 13       // uniform base-quality floor, all four callers

// Per-cell attribution: soft FILTER
// min_site_pooled_coverage set to 11, and it is inert compared to the previous 20 we have
// it is dominated by the bulk discovery floor above, since a site must carry
// bulk_min_alt_reads ALT reads to be a candidate at all, and that many ALT reads
// is already that many reads. Measured on dd7feb7 commit on a test data: 0 of 2,071 SNV sites
// and 0 of 66 indel sites dropped at 20.
// It becomes relevant again, if it goes above bulk_min_alt_reads above is lowered below it.
def min_site_pooled_coverage = 11   // pooled site gate in the per-cell pileup (reads summed over all cells)
def percell_flag_min_dp      = 5    // per-allele lowDP threshold; cell-support callable-coverage denominator
def percell_flag_min_vaf     = 0.01 // per-allele lowVAF threshold in raw_variants; cell-support vote threshold
def percell_flag_min_bq      = 15   // per-allele lowBQ threshold on mean_bq in raw_variants (SNV only; indels have no anchor base quality)
def percell_flag_min_mq      = 30   // per-allele lowMQ threshold on mean_mq in raw_variants
// lowDP/lowVAF/lowBQ/lowMQ annotate the allele observation only
// The genotype FILTER is GQ-only

// Per-cell genotype likelihood:
// eps and rho are the measurements seeded from a test data of 10M downsampled run.
// And as a matter of fact it is not a constant but a tuning parameter that can be
// set per run. Each run is expected to re-measure its own but that applies to
// eps ONLY. eps is measurable without a truth set (third alleles) but rho is not, and
// re-measuring it per run that is not ground truth bound is a mistake. It is a one-time
// calibration on a truth-bearing run, NOT a per-run measurement, which is why it stays
// a def and not a param.
def percell_min_gq    = 30      // genotype lowGQ / lowqual threshold
def percell_error_eps = 0.00045 // panel and assay wide error; hom-ref/hom-alt expected ALT fraction


def percell_error_rho = 0.091   // beta-binomial overdispersion (0 = binomial)
// IMPORTANT:
// rho cannot be estimated without a truth set. The truth-free substitute picks het sites on
// pooled VAF near 0.5, which discards all the sites carrying the most allelic imbalance which
// is exactly what rho measures.
//
// So rho above is calibrated ONCE on a ground truth bounded run and inherited by every other run.
// The truth sample used was S11/GM12827: S11-10M-sub, per cell per amplicon downsample cap 100,
// seed 42. And variants were checked against the GM bulk VCF restricted to the 50 panel spans.
//
// rho is deliberately NOT a pipeline parameter: a CLI knob is an invitation to re-estimate it
// per run, which is the mistake above. Which case a run is in is declared instead by
// params.gq_calibration ('inherited', the default, or 'truth-calibrated'), because only the
// launcher knows whether this sample has its own donor VCF. It reaches the detection-power
// report and nothing else; GT and outlier_lod are unaffected either way.

// Derived: the uniform AD/VAF discovery floor for every caller, applied at
// BCFTOOLS_FILTER (biallelic after norm, so FORMAT/AD = [REF, ALT]). variant_min_dp
// adds an INFO/DP term only when explicitly re-enabled (>0). A zero-depth record is
// already dropped by the AD term, so the VAF division is safe against division by zero!
def _dp_term = variant_min_dp > 0 ? "INFO/DP < ${variant_min_dp} || " : ''
def bcftools_filter_expr = "${_dp_term}FMT/AD[0:1] < ${bulk_min_alt_reads} || ((FMT/AD[0:0]+FMT/AD[0:1]) > 0 && (FMT/AD[0:1] / (FMT/AD[0:0]+FMT/AD[0:1])) < ${bulk_min_vaf})"

// Per-run variant detection power parameters:
// This is essentially a way to measure the expected number of sites panel-wide at
// which noise alone would ending having a false positive or eventualy a false clone.
def power_family_alpha = 0.05

// The discovery is intentionally permissive, so we end up with many potential false positives,
// so "all sites" and "sites anyone reports on" give false number of carrier-cell counts an order
// of magnitude apart; both are printed.
def power_min_callers  = 2

// Derived: named per-cell flags shared by both count_variant processes: SNv and INDEL.
//
// These strings are ext.args only:
//
//   COUNT_VARIANT        (bin/count_variant.py, ext.args = percell_snv_args)
//   COUNT_VARIANT_INDEL  (bin/count_variant_indel.py, ext.args = percell_common_args)
//     count_variant[_indel].py <bam> <fasta> <sample_name> <barcode_mapping> \
//                              <calls_parquet> <filtered_amplicon_reads> <ext.args>
//
// Both are defined in modules/dna_processing.nf and wired in the process block below.
def percell_common_args = "--min-site-pooled-coverage ${min_site_pooled_coverage} --flag-min-dp ${percell_flag_min_dp} --flag-min-vaf ${percell_flag_min_vaf} --flag-min-mq ${percell_flag_min_mq} --min-gq ${percell_min_gq} --error-eps ${percell_error_eps} --error-rho ${percell_error_rho}"
def percell_snv_args   = "${percell_common_args} --flag-min-bq ${percell_flag_min_bq}"

// The variant detection-power report reads the genotype model the run applied
// plus the bulk thresholds it discovered the variants under, so every one of these
// is the same. Finally, ADO is measured from the run itself.
//
//   DETECTION_POWER      (bin/detection_power_report.py, ext.args = detection_power_args)
//     detection_power_report.py <variants_count_parquet> <sample_name> <ext.args>
//
// --gq-calibration is a per-sample declaration and so a pipeline param. The script also
// accepts --ado to override the measured dropout rate; the pipeline never passes it,
// because a run that can measure its own must not be handed an assumed one.
def detection_power_args = "--min-gq ${percell_min_gq} --error-eps ${percell_error_eps} --error-rho ${percell_error_rho} --gq-calibration ${params.gq_calibration} --bulk-min-vaf ${bulk_min_vaf} --bulk-min-alt-reads ${bulk_min_alt_reads} --family-alpha ${power_family_alpha} --min-callers ${power_min_callers}"


process {

    withName: 'BCFTOOLS_NORM' {
        ext.args = '--multiallelics -both --rm-dup all'
    }

    withName: 'BCFTOOLS_FILL_TAGS' {
        ext.args = "-t 'INFO/VARQUAL:1=QUAL'"
    }

    withName: 'BCFTOOLS_MERGE' {
        ext.args = '--force-samples -m none'
    }

    withName: 'BCFTOOLS_MERGE_LOFREQ' {
        ext.args   = '--force-samples -m none'
        ext.prefix = { "${meta.sample_name}.lofreq.with_sample" }
    }

    // --- Variant filtering
    // All values come from the locals defined at the top of this file.

    withName: 'FREEBAYES' {
        ext.args = "--ploidy 2 --min-alternate-fraction ${freebayes_min_vaf} --min-alternate-count ${bulk_min_alt_reads} --min-base-quality ${bulk_min_bq} --min-coverage 0 --limit-coverage ${bulk_max_dp}"
    }
    // GATK HC has no min-ALT parm (uniform floor applied at BCFTOOLS_FILTER).
    // --max-reads-per-alignment-start = bulk_max_dp caps reads sharing the primer
    // start (~per-amplicon depth), bounding PairHMM which is the most computationally
    // intensive one without touching the BAM.
    withName: 'GATK4_HAPLOTYPECALLER' {
        ext.args = "--output-mode EMIT_VARIANTS_ONLY --sample-ploidy 2 --min-base-quality-score ${bulk_min_bq} --max-reads-per-alignment-start ${bulk_max_dp}"
    }
    // VarDict has no native DP param only VAF and alt read.
    withName: 'VARDICT' {
        ext.args  = "-f ${vardict_min_vaf} -r ${bulk_min_alt_reads} -q ${bulk_min_bq} -c 1 -S 2 -E 3 -g 4"
        ext.args2 = "-A -f ${vardict_min_vaf}"
    }
    // bcftools mpileup: annotate the fields the AD needs + per-position cap.
    withName: 'BCFTOOLS_CALL' {
        ext.args  = "--annotate FORMAT/AD,FORMAT/ADF,FORMAT/ADR,FORMAT/DP,FORMAT/SP,FORMAT/SCR,INFO/AD,INFO/ADF,INFO/ADR,INFO/SCR --min-BQ ${bulk_min_bq} --max-depth ${bulk_max_dp} --max-idepth ${bulk_max_dp}"
        ext.args2 = '--multiallelic-caller --variants-only --ploidy 2'
    }
    // Uniform AD/VAF discovery threshold for every caller (biallelic post-norm).
    withName: 'BCFTOOLS_FILTER' {
        ext.args = bcftools_filter_expr
    }

    // Per-cell attribution: soft-FILTER thresholds + the kept pooled site coverage
    // threshold, passed as flags to count_variant*.py
    withName: 'COUNT_VARIANT' {
        ext.args = percell_snv_args
    }
    withName: 'COUNT_VARIANT_INDEL' {
        ext.args = percell_common_args
    }
    // Per-run detection power: same model, same threshods
    withName: 'DETECTION_POWER' {
        ext.args = detection_power_args
    }
}
