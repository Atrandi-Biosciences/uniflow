nextflow_workflow {

    name "Test Workflow INPUT_VALIDATION"
    script "workflows/input_validation.nf"
    workflow "INPUT_VALIDATION"

    //tag-definition
    tag "workflow"
    tag "input_validation"
    //Test ID -> RNAampDNA_Traceability_Matrix
    tag "TEST-VALID-INPUT"
        // --- GLOBALE VARIABLES ---
    def debug = false
    def pathToInputCsv = "test_data/endToEnd"
    // ---------- RNA ----------
    // ----- LIBRARY_TYPE ------
    def Lib1_RNA_L001 = "Lib1_RNA_L001"
    def Lib1_RNA_L002 = "Lib1_RNA_L002"
    def Lib3_RNA_L001 = "Lib3_RNA_L001"
    def Lib3_RNA_L002 = "Lib3_RNA_L002"

    // ---------- DNA ----------
    // ----- LIBRARY_TYPE ------
    def Lib2_DNA_L001 = "Lib2_DNA_L001"
    def Lib2_DNA_L002 = "Lib2_DNA_L002"
    def Lib4_DNA_L001 = "Lib4_DNA_L001"
    def Lib4_DNA_L002 = "Lib4_DNA_L002"

    test("TEST-VALID-INPUT_001: Validation Should Accept a Valid FASTA File") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_valid_input"
            }
            workflow {
                """
                input[0] = Channel.value(
                    file("${projectDir}/test_data/workflows/input_validation/validation_successful.fasta", checkIfExists: true)
                )

                input[1] = channel.empty()

                
                input[2] = channel.value(false)
                """
            }
        }

        then {
            assert workflow.success
        }
    }

    test("TEST-VALID-INPUT_002: Validation with validation_fail.fa should run with failure") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_invalid_input"
            }
            workflow {
                """
                input[0] = Channel.value(
                    file("${projectDir}/test_data/workflows/input_validation/validation_fail.fa", checkIfExists: true)
                )
                input[1] = channel.empty()

                input[2] = channel.value(false)
                """
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("TEST-VALID-INPUT_003: Validation Should Reject FASTA Files with Invalid Amplicon Names") {

        skip() // testcase skiped. first we need du define the acceptance criterion

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_invalid_input"
            }
            workflow {
                """
                input[0] = Channel.value(
                    file("${projectDir}/test_data/workflows/input_validation/validation_invalid_amp_name.fasta")
                )
                input[1] = channel.empty()

                input[2] = channel.value(false)
                """
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("TEST-VALID-INPUT_004: Validation Should Reject FASTA Files with Duplicate IDs") {

        skip() // testcase skiped. first we need du define the acceptance criterion

        when {
            params {
                experiment_id = "test_invalid_input"
            }
            workflow {
                """
                input[0] = Channel.value(
                    file("${projectDir}/test_data/workflows/input_validation/validation_duplicate_ids.fasta")
                )
                input[1] = channel.empty()

                input[2] = channel.value(false)
                """
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("TEST-VALID-INPUT_005: Validation Should Reject FASTA Files with Invalid Bases") {

        skip() // testcase skiped. first we need du define the acceptance criterion

        when {
            params {
                experiment_id = "test_invalid_input"
            }
            workflow {
                """
                input[0] = Channel.value(
                    file("${projectDir}/test_data/workflows/input_validation/validation_invalid_bases.fasta")
                )
                input[1] = channel.empty()
                input[2] = channel.value(false)
                """
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("TEST-VALID-INPUT_006: Validation Should Reject FASTA Files Containing Empty Records") {

        skip() // testcase skiped. first we need du define the acceptance criterion

        when {
            params {
                experiment_id = "test_invalid_input"
            }
            workflow {
                """
                input[0] = Channel.value(
                    file("${projectDir}/test_data/workflows/input_validation/validation_empty_records.fasta")
                )
                input[1] = channel.empty()
                input[2] = channel.value(false)
                """
            }
        }

        then {
            assert workflow.failed
        }
    }
    
    test("TEST-VALID-INPUT_007: (FAIL) not_same_demux_indicies_for_same_sample: the testcase should run fail") {
        
        when {
            params {
                experiment_id = "test_invalid_input"
            }

            workflow {
                """
                input[0] = Channel.value(
                    file("${projectDir}/test_data/workflows/input_validation/validation_successful.fasta", checkIfExists: true)
                )
                // libraries
                input[1] = Channel.fromList([
                    [
                        [sample_name: 'sample1', library_id: '${Lib1_RNA_L001}', library_type: 'RNA', demultiplexing_indices: 'A1;A2'],
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib1_RNA_L001}_R1_001.fastq.gz"),
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib1_RNA_L001}_R2_001.fastq.gz")
                    ],
                    [
                        [sample_name: 'sample1', library_id: '${Lib2_DNA_L001}', library_type: 'DNA', demultiplexing_indices: 'B1;B2'],
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib2_DNA_L001}_R1_001.fastq.gz"),
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib2_DNA_L001}_R2_001.fastq.gz")
                    ]
                ])
                input[2] = channel.value(true)

                """
            }
        }

        then {
            if (debug) {
                TestUtils.print_output_channels(workflow)
                println "ERROR-REPORT: ${workflow.errorReport}"
                println "\nSTDOUT: ${workflow.stdout}"
                println "\nSTDERR: ${workflow.stderr}"
            }

            assert workflow.failed
        }
    }
    test("TEST-VALID-INPUT_008: (SUCCESS) same_demux_indicies_for_same_sample: the testcase should run successfully") {
        
        when {
            params {
                experiment_id = "test_valid_input"
            }

            workflow {
                """
                input[0] = Channel.value(
                    file("${projectDir}/test_data/workflows/input_validation/validation_successful.fasta", checkIfExists: true)
                )
                // libraries
                input[1] = Channel.fromList([
                    [
                        [sample_name: 'sample1', library_id: '${Lib1_RNA_L001}', library_type: 'RNA', demultiplexing_indices: 'A1;A2'],
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib1_RNA_L001}_R1_001.fastq.gz"),
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib1_RNA_L001}_R2_001.fastq.gz")
                    ],
                    [
                        [sample_name: 'sample1', library_id: '${Lib2_DNA_L001}', library_type: 'DNA', demultiplexing_indices: 'A1;A2'],
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib2_DNA_L001}_R1_001.fastq.gz"),
                        file("${params.imput_testdata}/qa/alpha2_test/${Lib2_DNA_L001}_R2_001.fastq.gz")
                    ]
                ])
                input[2] = channel.value(true)

                """
            }
        }

        then {
            if (debug) {
                TestUtils.print_output_channels(workflow)
                println "ERROR-REPORT: ${workflow.errorReport}"
                println "\nSTDOUT: ${workflow.stdout}"
                println "\nSTDERR: ${workflow.stderr}"
            }

            assert workflow.success
        }
    }
}
