nextflow_process {

    name "Test Process RNA_PROCESSING.EXTRACT_GENE_EXPRESSION_BAM"
    script "modules/rna_processing.nf"
    process "EXTRACT_GENE_EXPRESSION_BAM"

    //tag-definition
    tag "process"
    tag "process-rna_processing"
    tag "extract_gene_expression_bam"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"
            }
            process {
                """
                input[0] = Channel.of([
                    [
                        sample_name: 'sample1', 
                        library_type: 'RNA'
                    ],
                    file("${projectDir}/test_data/modules/rna_processing/extract_gene_expression_bam/sample1.Aligned.sortedByCoord.out.bam"),
                ])
                """
            }
        }

        then {
            assert process.success
        }

    }

}
