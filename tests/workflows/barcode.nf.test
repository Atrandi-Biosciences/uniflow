import groovy.json.JsonSlurper

nextflow_workflow {

    name "Test Workflow BARCODE"
    script "workflows/barcode.nf"
    workflow "BARCODE"

    //tag-definition
    tag "workflow"
    tag "barcode"

    def debug = false

    test("the creation of the parquet files should be successful.") {

         when {
            params {
                load("${projectDir}/tests/params.json")
                experiment_id = "test_barcode_pass"
            }
            workflow {
                """
                    // read2_libraries_ch
                    input[0] = Channel.fromList([
                        [
                            // library_id
                            "Lib1_RNA_L001",
                            // library_type
                            "RNA",
                            // read2
                            file("${params.imput_testdata}/qa/alpha2_test//Lib1_RNA_L001_R2_001.fastq.gz")                            
                        ],
                        [
                            // library_id
                            "Lib1_RNA_L002",
                            // library_type
                            "RNA",
                            // read2
                            file("${params.imput_testdata}/qa/alpha2_test/Lib1_RNA_L002_R2_001.fastq.gz")
                        ],
                        [
                            // library_id
                            "Lib2_DNA_L001",
                            // library_type
                            "DNA",
                            // read2
                            file("${params.imput_testdata}/qa/alpha2_test/Lib2_DNA_L001_R2_001.fastq.gz")
                        ],
                        [
                            // library_id
                            "Lib2_DNA_L002",
                            // library_type
                            "DNA",
                            // read2
                            file("${params.imput_testdata}/qa/alpha2_test/Lib2_DNA_L002_R2_001.fastq.gz")
                        ],
                        [
                            // library_id
                            "Lib3_RNA_L001", 
                            // library_type
                            "RNA",
                            // read2
                            file("${params.imput_testdata}/qa/alpha2_test/Lib3_RNA_L001_R2_001.fastq.gz")
                        ],
                        [
                            // library_id
                            "Lib3_RNA_L002",
                            // library_type
                            "RNA",
                            // read2
                            file("${params.imput_testdata}/qa/alpha2_test/Lib3_RNA_L002_R2_001.fastq.gz")
                        ],
                        [
                            // library_id
                            "Lib4_DNA_L001", 
                            // library_type
                            "DNA",
                            // read2
                            file("${params.imput_testdata}/qa/alpha2_test/Lib4_DNA_L001_R2_001.fastq.gz")
                        ],
                        [
                            // library_id
                            "Lib4_DNA_L002", 
                            // library_type
                            "DNA",
                            // read2
                            file("${params.imput_testdata}/qa/alpha2_test/Lib4_DNA_L002_R2_001.fastq.gz")
                        ]

                    ])

                    // inputs_validated
                    input[1] = Channel.value(true)

                    // whitelist_file_ch
                    input[2] = channel.value(file("${projectDir}/assets/barcodes/B4_24_v01/long.csv", checkIfExists: true))

                    // chemistry_json_path
                    input[3] = "${projectDir}/test_data/workflows/barcode/chemistry.json"
                """
            }
        }

        then {
            if (debug) {
                println "\n=== OUTPUT CHANNELS ==="
    
                println "\nbarcode_mapping (${workflow.out.barcode_mapping.size()} items):"
                println workflow.out.barcode_mapping
    
                println "\nmetrics_parquet (${workflow.out.metrics_parquet.size()} items):"
                println workflow.out.metrics_parquet
    
                println "\nqc (${workflow.out.qc.size()} items):"
                println workflow.out.qc
            }

            assert workflow.success

            def barcode = workflow.out.barcode_mapping
            def metrics = workflow.out.metrics_parquet
            def qc = workflow.out.qc

            assert barcode.size() == 8   // count files

            assert metrics.size() == 8   // count files

            assert qc.size() == 8        // count files
        }

    }

}
