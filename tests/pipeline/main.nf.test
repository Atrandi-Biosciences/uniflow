nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    //tag-definition
    tag "pipeline"
    tag "main"
    tag "uniflow"
    //Test ID -> RNAampDNA_Traceability_Matrix
    tag "TEST-E2E-001"


    test("The pipeline should run without failures") {

        skip()

        when {
            params {
                load("${projectDir}/tests/params.json")

                input_csv         = "${params.imput_testdata}/qa/variant_calling_beta/mixed.csv"
                star_index        = "${params.imput_testdata}/qa/variant_calling_beta/star_index_chr13"
                amplicon_fasta    = "${params.imput_testdata}/qa/test_ref.fasta"
                product_id        = "B4_24_v1"
                barcode_pool_size = 24
                experiment_id     = "00000000_XXX-000_mixed"
                outdir            = "${outputDir}"
            }

            options """ -c ${projectDir}/tests/config/nextflow-test.config --nextflow.preview.output true """
        }

        then {
            assert workflow.success
            assert snapshot(workflow).match()
        }

    }

}
