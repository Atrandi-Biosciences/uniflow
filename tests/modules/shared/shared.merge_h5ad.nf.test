nextflow_process {

    name "Test Process SHARED.MERGE_H5AD"
    script "modules/shared.nf"
    process "MERGE_H5AD"

    //tag-definition
    tag "process"
    tag "shared"
    tag "merge_h5ad"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"                
            }
            process {
                """
                input[0] = Channel.of([
                    [
                        sample_name: 'sample1'
                    ],

                    // bam
                    file("${projectDir}/test_data/modules/shared/merge_h5ad/mixed.csv"),

                    "test_experiment",

                    [
                        file("${projectDir}/test_data/modules/shared/merge_h5ad/sample1_raw_gene_counts.h5ad"),
                        file("${projectDir}/test_data/modules/shared/merge_h5ad/filtered_amplicon.h5ad"),
                        file("${projectDir}/test_data/modules/shared/merge_h5ad/snps_count.h5ad")
                    ]
                ])
                """
            }
        }

        then {
            assert process.success
        }

    }

}
