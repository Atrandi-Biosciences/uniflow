nextflow_process {

    name "Test Process SHARED.DEMULTIPLEX_PARQUET"
    script "modules/shared.nf"
    process "DEMULTIPLEX_PARQUET"

    //tag-definition
    tag "process"
    tag "shared"
    tag "demultiplex_parquet"

    test("DEMULTIPLEX_PARQUET Library_Type: RNA Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"                
            }
            process {
                """
                input[0] = Channel.of([
                    'Lib1_RNA_L001',
                    
                    'RNA',

                    [ sample_name: 'sample1', library_type: 'RNA' ],
                    
                    // read_file_1
                    file("${projectDir}/test_data/modules/shared/demultiplex_parquet/RNA/Lib1_RNA_L001_R1_001.fastq.gz"),
                
                    // read_file_2
                    file("${projectDir}/test_data/modules/shared/demultiplex_parquet/RNA/Lib1_RNA_L001_R2_001.fastq.gz"),

                    // read_file_4
                    file("${projectDir}/test_data/modules/shared/demultiplex_parquet/RNA/Lib1_RNA_L001_barcodes_mapping.parquet"),

                    // read_file_5
                    file("${projectDir}/test_data/modules/shared/demultiplex_parquet/RNA/sample_demultiplexing_sheet.csv")

                ])
                """
            }
        }

        then {
            assert process.success
            //assert snapshot(process.out).match()
        }

    }

    test("DEMULTIPLEX_PARQUET Library_Type: DNA Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"                
            }
            process {
                """
                input[0] = Channel.of([
                    'Lib2_DNA_L001',
                    
                    'DNA',

                    [ sample_name: 'sample1', library_type: 'DNA' ],
                    
                    // read_file_1
                    file("${projectDir}/test_data/modules/shared/demultiplex_parquet/DNA/Lib2_DNA_L002_R1_001.fastq.gz"),
                
                    // read_file_2
                    file("${projectDir}/test_data/modules/shared/demultiplex_parquet/DNA/Lib2_DNA_L002_R2_001.fastq.gz"),

                    // read_file_4
                    file("${projectDir}/test_data/modules/shared/demultiplex_parquet/DNA/Lib2_DNA_L002_barcodes_mapping.parquet"),

                    // read_file_5
                    file("${projectDir}/test_data/modules/shared/demultiplex_parquet/DNA/sample_demultiplexing_sheet.csv")

                ])
                """
            }
        }

        then {
            assert process.success
            //assert snapshot(process.out).match()
        }

    }

}
