nextflow_process {

    name "Test Process AGGREGATION.AGGREGATE_METRICS"
    script "modules/aggregation.nf"
    process "AGGREGATE_METRICS"

    //tag-definition
    tag "process"
    tag "aggregation"
    tag "aggregate_metrics"

    //tag-definition
    tag "process"

    test("Should run without failures") {

        skip()
        
        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"
            }
            process {
                """
                input[0] = Channel.of([
                    "00000000_XXX-000_mixed",
                    
                    [
                        file("${projectDir}/test_data/modules/aggregation/aggregate_metrics/1/metrics.csv"),
                        file("${projectDir}/test_data/modules/aggregation/aggregate_metrics/2/metrics.csv"),
                        file("${projectDir}/test_data/modules/aggregation/aggregate_metrics/3/metrics.csv"),
                        file("${projectDir}/test_data/modules/aggregation/aggregate_metrics/4/metrics.csv"),
                        file("${projectDir}/test_data/modules/aggregation/aggregate_metrics/5/metrics.csv")
                    ]
                ])
                """
            }
        }

        then {
            assert process.success
        }

    }

}
