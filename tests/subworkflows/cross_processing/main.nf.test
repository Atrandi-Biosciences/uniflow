nextflow_workflow {

    name "Test Workflow CROSS_PROCESSING"
    script "subworkflows/cross_processing/main.nf"
    workflow "CROSS_PROCESSING"

    //tag-definition
    tag "subworkflow"
    tag "cross_processing"

    test("Should run without failures") {

        skip()

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"
            }
            workflow {
                """
                // rna_libraries 
                input[0] = Channel.of([
                    [ sample_name: 'sample1', library_type: 'RNA' ],
                    
                    // read_file_1
                    //ANTGACCTTAAGTTCATTGACACCACCTCCAAGTTTGGCCATGGCCGCTTCCAGACCATGGAGGAGAAGAAAGCATTCATGGGACCACTGAAGAAAGACCGAATTGCAAAGGAAGAAGAAGCTTAATGCCAGGAACAGATTTTGCAGT
                    file("${projectDir}/test_data/subworkflows/cross_processing/RNA/sample1_RNA_R1.fastq.gz"),
                
                    // read_file_2
                    //GTGAGACTAGGACACCTTGAACTCCACCATCTAAGGCATACCGTGACTTGAGTGGCTGTCGGCTGAGCTT
                    file("${projectDir}/test_data/subworkflows/cross_processing/RNA/sample1_RNA_R2.fastq.gz"),
                ])

                // amplicon_fasta_file_ch
                input[1] = Channel.value(
                    file("${projectDir}/test_data/subworkflows/cross_processing/RNA/test_ref.fasta")
                )

                // rna_full_reads
                input[2] = Channel.fromList([
                [
                    [ sample_name: 'sample1', library_type: 'RNA' ], 
                    file("${projectDir}/test_data/subworkflows/cross_processing/RNA/full_read_RNA.parquet")
                ]
                ])

                // top_cells_parquet ------------- ATTENTION --------------- the input-file is incorrect. Used only to check the testrun.
                input[3] = Channel.fromList([
                [
                    [ sample_name: 'sample1', library_type: 'RNA' ],
                    file("${projectDir}/test_data/subworkflows/cross_processing/RNA/sample1_filtered_reads.parquet")
                ]
                ])
                """
            }
        }

        then {
            assert workflow.success
            //assert snapshot(workflow.out).match()
        }

    }

}
