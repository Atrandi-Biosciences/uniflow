nextflow_process {

    name "Test Process REPORT.GENERATE_MULTIQC_CUSTOM"
    script "modules/report.nf"
    process "GENERATE_MULTIQC_CUSTOM"

    //tag-definition
    tag "process"
    tag "report"
    tag "generate_multiqc_custom"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
                experiment_id = "test_experiment"
            }
            process {
                """
                //metrics_reference
                input[0] = file("${projectDir}/test_data/modules/report/generate_multiqc_custom/metrics_reference.csv")

                //aggregated_metrics
                input[1] = Channel.of(["sample1", file("${projectDir}/test_data/modules/report/generate_multiqc_custom/metrics.csv")])
                
                // output 
                input[2] = "aggregated_multiqc_config.yaml"

                // scope
                input[3] = "aggregated"
                """
            }
        }

        then {
            assert process.success
        }

    }

}
